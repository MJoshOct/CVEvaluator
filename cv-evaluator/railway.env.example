# Copy this file, fill in real values, and paste into Railway's Variables tab
# DO NOT commit this file with real values to git

# Required
SECRET_KEY=generate-a-50-char-random-string-here
DATABASE_URL=postgresql://...  # Railway provides this automatically when you add PostgreSQL addon
DEBUG=False
ALLOWED_HOSTS=your-app.up.railway.app

# CORS - set to your frontend domain (or same Railway URL if full-stack)
CORS_ALLOWED_ORIGINS=https://your-app.up.railway.app
CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app

# AI
AI_API_KEY=your-groq-or-openai-key
AI_PROVIDER=groq
AI_MODEL=llama-3.1-8b-instant

# Google OAuth (optional - can be set via Admin Console in app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gunicorn
GUNICORN_WORKERS=2
