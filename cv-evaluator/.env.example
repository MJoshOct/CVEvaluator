# ==============================================================================
# CV Evaluator Environment Configuration
# ==============================================================================

# Database Configuration
POSTGRES_USER=cveval_user
POSTGRES_PASSWORD=cveval_pass
POSTGRES_DB=cveval_db

# Django Configuration
SECRET_KEY=django-insecure-cveval-dev-key-change-in-production
DEBUG=True

# AI Model Configuration
# You can leave this empty and provide your API key directly in the UI per evaluation,
# or set it here as the global server-side default.
# Supported formats:
# - Groq (Free & Fast - https://console.groq.com/keys): gsk_...
# - Google Gemini: AIzaSy...
# - OpenAI: sk-...
AI_API_KEY=
AI_PROVIDER=groq
AI_MODEL=llama-3.1-8b-instant

# Network / Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Google OAuth Configuration (Optional - set when you get your Google Cloud credentials)
# Obtain from https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client IDs)
VITE_GOOGLE_CLIENT_ID=

